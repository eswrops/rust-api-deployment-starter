#!/usr/bin/env bash
# rust-api-backup: online SQLite snapshot + off-site upload to a private GCS
# bucket, with local and remote retention and a heartbeat object.
#
# Runs as the rustapi service account (systemd timer rust-api-backup.timer,
# daily 04:15 UTC). Configuration comes from /etc/rust-api/backup.env. A
# non-zero exit triggers rust-api-backup-alert@.service via OnFailure.
set -Eeuo pipefail

LIB_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=rust-api-backup-lib.sh
. "$LIB_DIR/rust-api-backup-lib.sh"

ENV_FILE="${BACKUP_ENV_FILE:-/etc/rust-api/backup.env}"
[ -r "$ENV_FILE" ] || { echo "backup env not readable: $ENV_FILE" >&2; exit 1; }
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

: "${GCS_BUCKET:?GCS_BUCKET must be set}"
: "${GCS_KEY_FILE:?GCS_KEY_FILE must be set}"
: "${DATABASE_URL:=sqlite:///var/lib/rust-api/app.db}"
: "${BACKUP_DIR:=/var/lib/rust-api/backups}"
: "${LOCAL_KEEP_DAYS:=7}"
: "${OFFSITE_KEEP_DAYS:=30}"
# Live off-site snapshots that retention must never expire, regardless of
# age. The newest snapshots are protected so a stale or misdated bucket can
# never be driven to zero recoverable copies by the retention pass itself.
: "${MIN_LIVE_SNAPSHOTS:=3}"

DB_PATH="${DATABASE_URL#sqlite://}"
[ -n "$DB_PATH" ] && [ "$DB_PATH" != "$DATABASE_URL" ] || DB_PATH="${DATABASE_URL#sqlite:}"
[ -r "$DB_PATH" ] || { echo "database not readable: $DB_PATH" >&2; exit 1; }
[ -r "$GCS_KEY_FILE" ] || { echo "backup key not readable: $GCS_KEY_FILE" >&2; exit 1; }

install -d -m 0700 "$BACKUP_DIR" 2>/dev/null || true

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
snapshot="$BACKUP_DIR/app-$stamp.db"

echo "backing up $DB_PATH (WAL online copy)"
tmp_snapshot="$BACKUP_DIR/.app-$stamp.db.partial"
sqlite_snapshot "$DB_PATH" "$tmp_snapshot" >&2 || { rm -f "$tmp_snapshot"; exit 1; }
mv "$tmp_snapshot" "$snapshot"
digest="$(sha256sum "$snapshot" | awk '{print $1}')"
size="$(wc -c <"$snapshot" | tr -d ' ')"
chmod 0600 "$snapshot"
echo "snapshot $snapshot ($size bytes, sha256 $digest)"

# Local quick-recovery copy + retention (app-latest.db is always overwritten).
cp "$snapshot" "$BACKUP_DIR/.app-latest.db.tmp"
mv "$BACKUP_DIR/.app-latest.db.tmp" "$BACKUP_DIR/app-latest.db"
find "$BACKUP_DIR" -maxdepth 1 -name 'app-2*.db' -mtime "+$LOCAL_KEEP_DAYS" -print -delete |
  sed 's|^|local retention: expired |'

echo "uploading to gs://$GCS_BUCKET/snapshots/app-$stamp.db"
gcs_upload "$GCS_KEY_FILE" "$GCS_BUCKET" "snapshots/app-$stamp.db" "$snapshot" || exit 1

heartbeat="$(mktemp)"
{
  echo "backup ok $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "object snapshots/app-$stamp.db"
  echo "sha256 $digest"
  echo "size $size"
  echo "host $(hostname)"
} >"$heartbeat"
gcs_upload "$GCS_KEY_FILE" "$GCS_BUCKET" "heartbeat.txt" "$heartbeat" "text/plain" ||
  { rm -f "$heartbeat"; exit 1; }
rm -f "$heartbeat"
printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$digest" >"$BACKUP_DIR/last-backup-success"
# A success clears the sticky ALERT marker (ALERT.log keeps the history);
# systemctl --failed was already reset by the unit leaving failed state.
rm -f "$BACKUP_DIR/ALERT"

# Off-site retention over the expirable prefixes. The versions=true listing
# marks superseded object versions with a timeDeleted field: noncurrent
# versions older than the 7-day recovery window are purged, live snapshots
# older than OFFSITE_KEEP_DAYS are expired. Alerts and the heartbeat stay.
#
# Failure semantics: a listing failure aborts retention with a non-zero
# exit (the OnFailure alert fires) — retention must never run on a partial
# listing. Deletion failures are counted per object, reported, and fail the
# run; only successful API operations are reported as deletions. 404 is a
# safe retention race (object already gone), not a failure.
cutoff_live="$(iso_days_ago "$OFFSITE_KEEP_DAYS")"
cutoff_versions="$(iso_days_ago 7)"
listing="$(gcs_list "$GCS_KEY_FILE" "$GCS_BUCKET" "")" || {
  echo "off-site retention: listing failed; retention NOT attempted (snapshot and heartbeat above are unaffected)" >&2
  exit 1
}
# The newest MIN_LIVE_SNAPSHOTS live snapshots by updated timestamp are
# exempt from expiry, whatever their age. sed -n (not head) so the pipeline
# reads to EOF: an early-exiting reader would SIGPIPE the sort and, under
# pipefail, kill the whole run on buckets larger than a page.
protected_live="$(printf '%s\n' "$listing" \
  | awk -F'|' '$2 == "" && $4 ~ /^snapshots\// {print $1 "|" $4}' \
  | sort -r | sed -n "1,${MIN_LIVE_SNAPSHOTS}p" | cut -d'|' -f2)"
deleted=0
failed_deletes=0
while IFS='|' read -r updated time_deleted generation name; do
  [ -n "$name" ] || continue
  case "$name" in
    snapshots/* | drills/*) ;;
    *) continue ;;
  esac
  if [ -n "$time_deleted" ]; then
    [ "${time_deleted%%T}" \< "$cutoff_versions" ] || continue
    reason="purged superseded version (updated $updated)"
    gen="$generation"
  elif [ "${updated%%T}" \< "$cutoff_live" ] && ! grep -Fxq "$name" <<<"$protected_live"; then
    # Live expiry deliberately omits the generation: the live version is
    # archived first and only purged once it leaves the 7-day window.
    reason="expired (updated $updated)"
    gen=""
  else
    continue
  fi
  # $gen is intentionally unquoted: empty means "expire the live version"
  # (no generation argument), non-empty passes the version's generation.
  # shellcheck disable=SC2086
  if gcs_delete "$GCS_KEY_FILE" "$GCS_BUCKET" "$name" $gen >/dev/null; then
    echo "off-site retention: deleted $name ($reason)"
    deleted=$((deleted + 1))
  else
    echo "off-site retention: FAILED to delete $name (generation ${gen:-live}) — object left in place" >&2
    failed_deletes=$((failed_deletes + 1))
  fi
done < <(printf '%s\n' "$listing")
echo "off-site retention: $deleted object(s) expired, $failed_deletes deletion(s) failed"
[ "$failed_deletes" -eq 0 ] || {
  echo "off-site retention: INCOMPLETE — deletion failures must be investigated (bucket retains all undeleted objects)" >&2
  exit 1
}

echo "backup complete: gs://$GCS_BUCKET/snapshots/app-$stamp.db"
