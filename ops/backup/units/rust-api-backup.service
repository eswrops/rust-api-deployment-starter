[Unit]
Description=rust-api SQLite snapshot and GCS off-site backup
Wants=network-online.target
After=network-online.target rust-api.service
OnFailure=rust-api-backup-alert@%n.service

[Service]
Type=oneshot
User=rustapi
Group=rustapi
ExecStart=/usr/local/sbin/rust-api-backup
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rust-api
TimeoutStartSec=600
