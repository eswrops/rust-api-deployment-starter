[Unit]
Description=rust-api restore drill: restore off-site backup and verify
Wants=network-online.target
After=network-online.target rust-api.service
OnFailure=rust-api-backup-alert@%n.service

[Service]
Type=oneshot
User=rustapi
Group=rustapi
ExecStart=/usr/local/sbin/rust-api-restore-drill
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rust-api
TimeoutStartSec=600
