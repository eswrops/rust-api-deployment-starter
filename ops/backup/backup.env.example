# Installed as /etc/rust-api/backup.env (root:rustapi 0640) by
# ops/install-backups.sh. Sourced by the backup, drill and alert scripts.
# DATABASE_URL must match the production service environment exactly.
DATABASE_URL=sqlite:///var/lib/rust-api/app.db
GCS_BUCKET=REPLACE_WITH_BUCKET
GCS_KEY_FILE=/etc/rust-api/backup-gcs-key.json
BACKUP_DIR=/var/lib/rust-api/backups
LOCAL_KEEP_DAYS=7
OFFSITE_KEEP_DAYS=30
