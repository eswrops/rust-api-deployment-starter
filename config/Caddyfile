api-bench.thetechs.top {
    encode zstd gzip

    # Production rust-api keeps its two health endpoints on 127.0.0.1:8080.
    handle /health/live {
        reverse_proxy 127.0.0.1:8080
    }
    handle /health/ready {
        reverse_proxy 127.0.0.1:8080
    }

    # The SPEC.md feed API (benchmark/feed-api) on 127.0.0.1:8081 is the
    # site default: /health, /feed, /posts*, and spec-mandated JSON 404s
    # ({"error":"not found"}) for unknown paths.
    handle {
        reverse_proxy 127.0.0.1:8081
    }
}
